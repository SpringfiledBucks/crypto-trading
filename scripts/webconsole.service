[Unit]
Description=Crypto Trading Web Console
After=network.target

[Service]
Type=simple
User=crypto
WorkingDirectory=/home/crypto/crypto-trading
# ExecStart updated to use the compiled C++ binary. Ensure the binary exists at this path after building.
ExecStart=/home/crypto/crypto-trading/build/crypto_trading
Restart=on-failure

[Install]
WantedBy=multi-user.target
