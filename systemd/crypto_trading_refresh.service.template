[# Template]
# This one-shot service triggers the project's refresh action via the template
# runner script. Copy to ~/.config/systemd/user/ and enable similarly to the
# main service. Adjust ExecStart path if you don't use `%h`.

[Unit]
Description=Crypto Trading Refresh (template)
After=network.target

[Service]
Type=oneshot
WorkingDirectory=%h/crypto-trading
ExecStart=%h/crypto-trading/scripts/run.sh install-systemd

[Install]
WantedBy=multi-user.target
