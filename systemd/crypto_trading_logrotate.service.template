[# Template]
# One-shot service to run log rotation. Copy to ~/.config/systemd/user/ and
# enable or schedule via the accompanying timer template. Replace `%h` if needed.

[Unit]
Description=Crypto Trading Logrotate (template)
After=network.target

[Service]
Type=oneshot
WorkingDirectory=%h/crypto-trading
ExecStart=%h/crypto-trading/scripts/rotate_logs.sh

[Install]
WantedBy=multi-user.target
