[Unit]
Description=Precompute Kline Aggregates for crypto-trading
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/crypto-trading
# Use the compiled C++ precompute tool for scheduled runs for better performance
ExecStart=%h/crypto-trading/build/precompute --all
Environment=PYTHONUNBUFFERED=1
TimeoutStartSec=1800
# Redirect stdout/stderr to a user-writable path under ~/.config
StandardOutput=append:%h/.config/crypto-trading/logs/precompute.log
StandardError=append:%h/.config/crypto-trading/logs/precompute.log
Nice=10

[Install]
WantedBy=default.target
