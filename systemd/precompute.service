Description=Precompute Kline Aggregates for crypto-trading
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/crypto-trading
ExecStart=/usr/bin/env python3 %h/crypto-trading/scripts/precompute_aggregates.py
Environment=PYTHONUNBUFFERED=1
